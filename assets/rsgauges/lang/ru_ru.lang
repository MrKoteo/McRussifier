# Всплывающая подсказка
tile.rsgauges.flatgauge1.help=§6Устройство отображения, которое можно прикрепить к твёрдому блоку для визуализации силы редстоуна этого блока.§r\n\
                              Если блок сам может выдавать энергию, датчик использует его выходной сигнал, в противном случае он косвенно измеряет мощность, которую блок получает от соседних блоков. \
                              Поддерживается сильное и слабое питание. Косвенные слабые измерения могут иметь небольшую задержку.
tile.rsgauges.flatgauge2.help=${tile.rsgauges.flatgauge1.help}
tile.rsgauges.flatgauge3.help=${tile.rsgauges.flatgauge1.help}
tile.rsgauges.flatgauge4.help=${tile.rsgauges.flatgauge1.help}
tile.rsgauges.flatgauge5.help=${tile.rsgauges.flatgauge1.help}
tile.rsgauges.flatgauge6.help=${tile.rsgauges.flatgauge1.help}
tile.rsgauges.gauge_rustic2.help=${tile.rsgauges.flatgauge1.help}

